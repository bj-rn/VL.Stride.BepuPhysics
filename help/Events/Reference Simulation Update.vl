          <Pad Id="HbSU000000000000000015" Bounds="196,312,681,91" ShowValueBox="true" isIOBox="true" Value="SimulationUpdate reports every physics step. The ForEach (Reactive) region runs once per physics step and pulls the sphere towards a target with an impulse scaled by the step's Time Step, the pull stays identical at any display frame rate. The hook component must be attached to an entity in the scene (here: the ground).">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">10</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
