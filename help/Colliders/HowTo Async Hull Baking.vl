      <Patch Id="AJHjw4NypoBdahzmKMDMD0">
        <Canvas Id="oEp0WldpQmfOA2CsN3OxT2" CanvasType="Group">
          <Pad Id="oLat58GfJIVRqdoE9Y6Ps0" Bounds="69,198,564,93" ShowValueBox="true" isIOBox="true" Value="Async hull baking: the convex hull computation runs on a background thread, In Progress reports activity.&#13;&#10;Left: HullFromModel (Async) reduces the torus vertices to their hull; only the GPU readback stays on the main thread.&#13;&#10;Right: HullFromPoints (Async) bakes a hull from a point spread.&#13;&#10;The baked hulls carry only the reduced hull points, so the hull build the engine still runs on the main thread when a collider attaches is trivial. ColliderShapes draws the baked hulls; unlike the sync nodes the async ones carry triangle data.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">10</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="UfLtI3Nn0TZDMxsJ9Nn9x3" Bounds="1002,783,428,62" ShowValueBox="true" isIOBox="true" Value="The points recipe: any point cloud works, degenerate input (fewer than 4 distinct points, or all in one plane) outputs null.&#13;&#10;Here: the 8 corners of a unit cube. For per glyph text hulls see HullsFromPointGroups (Async) and the HowTo Physical 3d Text patch in VL.Stride.Text3d.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
