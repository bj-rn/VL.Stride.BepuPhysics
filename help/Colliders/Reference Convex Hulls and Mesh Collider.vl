          <Pad Id="HbCX000000000000000015" Bounds="69,198,564,93" ShowValueBox="true" isIOBox="true" Value="Convex hull baking: one torus Model drives the visible mesh and its physics shape.&#xD;&#xA;Left: HullFromModel bakes the convex envelope (the hole is filled). &#xD;&#xA;Middle: the same Model as MeshCollider (the hole works). &#xD;&#xA;Right: HullFromPoints builds a hull from a point spread.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">10</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="HbCX000000000000000016" Bounds="1002,783,428,62" ShowValueBox="true" isIOBox="true" Value="The points recipe: any point cloud works. A 2D outline mirrored at +Depth/2 and -Depth/2 gives an extruded polygon collider. &#xD;&#xA;Here: the 8 corners of a unit cube.">
