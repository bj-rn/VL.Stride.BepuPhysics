          <Pad Id="IwIxy87zQ3aLD8GXxEtKGf" Comment="" Bounds="835,851,35,49" ShowValueBox="true" isIOBox="true" />
          <Pad Id="FZtbP03kzOAP6HYGHgrMWO" Bounds="367,686,316,275" ShowValueBox="true" isIOBox="true" Value="RayCast is a stateless operation (plain static method). It returns a single closest hit, need no state between frames, so it's imported as operation nodes — a pure function call with exactly the pins the signature declares.&#xD;&#xA;&#xD;&#xA;It takes a simulation and tests the ray against everything in it, through Bepu's broadphase. It answers &quot;what is the first thing this ray hits anywhere in the world&quot;, the hit tells you which collidable it was.&#xD;&#xA;&#xD;&#xA;Use for picking, shooting, or probing the scene when you don't know what's out there.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Doi399d38yKN16bIWnM8os" Bounds="988,687,451,271" ShowValueBox="true" isIOBox="true" Value="RayCastPenetrating is a  process node ([ProcessNode] class). It has to be stateful because it collects an arbitrary number of hits into a reusable SpreadBuilder, so each frame's spread can be produced without allocating. &#xD;&#xA;&#xD;&#xA;Setting Enabled to false doesn't output and empty spread, it skips Update entirely, the output holds its last values.&#xD;&#xA;&#xD;&#xA; &quot;Don't stop at the first surface&quot; variant: instead of returning the single closest hit, it collects every hit along the ray within Max Distance and outputs them as a Spread&lt;HitInfo&gt;, sorted by distance.&#xD;&#xA;&#xD;&#xA;Tests against the whole simulation: every collidable the ray passes through contributes hits, filterable by Collision Mask. Think &quot;laser through the scene&quot;: you get each thing it would pierce, in order.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="CU7vym8AhkFN6q6ecYxmwG" Comment="Enabled" Bounds="972,630,35,35" ShowValueBox="true" isIOBox="true" Value="True">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="ImmutableTypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Toggle</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="M37vmfkxEWOMGS6HUs1JkR" Bounds="74,198,726,76" ShowValueBox="true" isIOBox="true" Value="https://doc.stride3d.net/latest/en/api/Stride.BepuPhysics.BepuSimulation.html#Stride_BepuPhysics_BepuSimulation_RayCastPenetrating_Stride_Core_Mathematics_Vector3__Stride_Core_Mathematics_Vector3__System_Single_System_Collections_Generic_ICollection_Stride_BepuPhysics_HitInfo__Stride_BepuPhysics_CollisionMask_">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
