          </Node>
          <Pad Id="PRqyiz3Eh7HPfKWF0VnDhj" Bounds="2339,687,386,115" ShowValueBox="true" isIOBox="true" Value="Tests against a single collidable only and reports all hits through its shapes, for example the entry and exit surfaces through a compound's children, or every triangle crossing in a mesh collider. Everything else in the simulation is ignored. This is how you'd measure where a ray enters and leaves one particular object, e.g. for wall thickness or cut-through effects.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
