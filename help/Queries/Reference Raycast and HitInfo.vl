          </Node>
          <Pad Id="DInPilsVQKcLM03UEWkMS3" Comment="Point" Bounds="1600,955,35,43" ShowValueBox="true" isIOBox="true" />
          <Pad Id="QvqoLG7kwg3M8CLhttWhNy" Comment="Normal" Bounds="1620,905,35,43" ShowValueBox="true" isIOBox="true" />
          <Pad Id="U9tZ2DB3YUbN9AvLgB2AfV" Comment="Distance" Bounds="1640,880,35,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="SzOPoWZp2ODM5giEUigvFI" Bounds="1750,687,362,233" ShowValueBox="true" isIOBox="true" Value="Takes a single collidable and tests the ray against only that component's shape (it calls the upstream per-collidable CollidableComponent.RayCast). Nothing else in the world is considered. Other objects standing in the ray's path don't block or appear in the result. It answers &quot;does this ray hit this specific object, and where on it&quot;&#xD;&#xA;&#xD;&#xA;Use when you already have the target and want a cheap targeted test. For example checking where on a known object a pointer ray lands, or measuring the distance to one particular body without paying for (or being disturbed by) the rest of the scene.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="2221,678,104,19" Id="GXprytCgGTRNcrxv0BmZYQ">
            <p:NodeReference LastCategoryFullName="Stride.Physics.Bepu.Components.Collidable" LastDependency="VL.Stride.BepuPhysics.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <CategoryReference Kind="ClassType" Name="Collidable" NeedsToBeDirectParent="true" />
              <Choice Kind="ProcessAppFlag" Name="RayCastPenetrating" />
            </p:NodeReference>
            <p:HelpFocus p:Assembly="VL.Lang" p:Type="VL.Model.HelpPriority">High</p:HelpFocus>
            <Pin Id="U1SktUlUoiCNgYI8GGRyol" Name="Collidable" Kind="InputPin" />
            <Pin Id="G87OmXKylISOVI645nFebm" Name="Origin" Kind="InputPin" />
            <Pin Id="BRddAFDj5rFNGvpkEMMhil" Name="Direction" Kind="InputPin" />
            <Pin Id="RSXcyty3kzXNZ0245L9tlE" Name="Max Distance" Kind="InputPin" />
            <Pin Id="KsGBaRiHRJTNrsXp9FqlRY" Name="Enabled" Kind="InputPin" />
