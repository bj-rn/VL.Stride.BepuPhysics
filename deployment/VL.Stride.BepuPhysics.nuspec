<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/10/nuspec.xsd">
  <metadata>
    <id>VL.Stride.BepuPhysics</id>
    <version>0.11.1</version>
    <title>VL.Stride.BepuPhysics</title>
    <authors>bj-rn</authors>
    <owners>bj-rn</owners>
    <projectUrl>https://github.com/bj-rn/VL.Stride.BepuPhysics</projectUrl>
    <repository type="git" url="https://github.com/bj-rn/VL.Stride.BepuPhysics.git" />
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>
        BepuPhysics v2 rigid body physics for vvvv gamma, based on Stride.BepuPhysics and integrated
        with the VL.Stride entity system: bodies, statics, a character controller, collider shapes
        with runtime convex hull baking, all 30 constraint types with runtime get and set access,
        raycast/sweep/overlap queries, contact events and trigger volumes, collision filtering via
        layers and groups, per step simulation hooks, live simulation settings and debug views of
        the physics world.
    </description>
    <tags>VL, vvvv, gamma, stride, stride3d, physics, bepu, bepuphysics, rigidbody</tags>
    <license type="expression">MIT</license>
    <readme>docs\README.md</readme>
    <dependencies>
      <!-- Exact pins. Stride.BepuPhysics must match the Stride version bundled with the
           targeted vvvv release (a floor constraint would let the resolver walk up to 4.3.x,
           which targets a Stride version vvvv doesn't ship). BepuPhysics is pinned to the
           exact beta this library was built against (BepuUtilities comes transitively).
           Both are prerelease-dependent: install with `nuget install -prerelease`. -->
      <dependency id="BepuPhysics" version="[2.5.0-beta.25]" />
      <dependency id="Stride.BepuPhysics" version="[4.2.1.2487]" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\lib\**\VL.Stride.BepuPhysics.dll" target="lib\" />
    <file src="..\lib\**\VL.Stride.BepuPhysics.xml" target="lib\" />
    <file src="..\*.vl" target="" />
    <file src="..\help\**" target="help\" />
    <file src="..\README.md" target="docs\" />
  </files>
</package>
